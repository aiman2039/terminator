#!/bin/sh
set -eu
cd "$(git rev-parse --show-toplevel)"
# git-release already checked this exact tree in an isolated checkout.
if [ -n "${TERMINATOR_RELEASE_VALIDATED_TREE:-}" ] && \
    [ "$(git write-tree)" = "$TERMINATOR_RELEASE_VALIDATED_TREE" ]; then
    exit 0
fi
# Quick checks only; pre-push runs the full set.
exec sh scripts/check.sh quick
