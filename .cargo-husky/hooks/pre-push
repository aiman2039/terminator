#!/bin/sh
set -eu
cd "$(git rev-parse --show-toplevel)"
# git-release already checked this exact tree in an isolated checkout.
if [ -n "${TERMINATOR_RELEASE_VALIDATED_TREE:-}" ] && \
    [ "$(git rev-parse 'HEAD^{tree}')" = "$TERMINATOR_RELEASE_VALIDATED_TREE" ]; then
    exit 0
fi
# Full set (build, both clippy passes, audit, deny) against the working tree.
exec sh scripts/check.sh
